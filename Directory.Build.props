<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>$([System.IO.File]::ReadAllText(&quot;$(MSBuildThisFileDirectory)VERSION&quot;).Trim())</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(GITHUB_RUN_NUMBER)' != ''">
    <AssemblyMetadata Include="ArcanaUpdateBuild" Value="$(GITHUB_RUN_NUMBER)" />
  </ItemGroup>
</Project>
