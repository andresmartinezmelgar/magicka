rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}: uid/name strings; gold/wins/losses/itemCount/schemaVersion ints.
    // The owner may create only the empty version-1 header. Counters and item
    // records are subsequently managed by the server; no client header updates.
    // users/{uid}/loadouts/active: four required string item IDs (boots/hat/chest/weapon),
    // plus optional goldRing/magicRing strings. Empty means unequipped; otherwise
    // a 32-hex ID of an owned item matching its slot. Only the Google owner writes.
    // Item rolls and UpgradeLevel are server managed; clients cannot change items or gold.
    function googleOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // matchStatistics/{runId}-{revision}-{status}: informe anónimo inmutable.
    // Campos obligatorios: schemaVersion=1, runId hexadecimal de 32 caracteres,
    // revision/status enteros acotados, day ISO, mode/map enumerados,
    // gameVersion semántica, complete booleano y payload JSON de hasta 240 KiB.
    // El cliente valida el JSON. Las cifras no son autoritativas para premios.
    // statisticsReaders/{uid}: { enabled: bool }; solo Admin concede o revoca roles.
    function statisticsReader() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/statisticsReaders/$(request.auth.uid))
        && get(/databases/$(database)/documents/statisticsReaders/$(request.auth.uid)).data.enabled == true;
    }
    match /statisticsReaders/{uid} {
      allow get: if googleOwner(uid);
      allow list, write: if false;
    }
    function validStatistics(id, data) {
      return data.keys().hasOnly(['schemaVersion', 'runId', 'revision', 'status', 'day', 'mode', 'map', 'gameVersion', 'complete', 'payload'])
        && data.keys().hasAll(['schemaVersion', 'runId', 'revision', 'status', 'day', 'mode', 'map', 'gameVersion', 'complete', 'payload'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.runId is string && data.runId.matches('^[0-9a-f]{32}$')
        && data.revision is int && data.revision > 0 && data.revision <= 1892160000
        && data.status is int && data.status >= 1 && data.status <= 5
        && id == data.runId + '-' + string(data.revision) + '-' + string(data.status)
        && data.day is string && data.day.matches('^(20[2-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.mode in ['Duel', 'Arena', 'Warfare', 'Defense']
        && data.map in ['Classic', 'Citadel', 'Ascension', 'Relics', 'Frontline', 'Practice', 'Bastion']
        && data.gameVersion is string && data.gameVersion.matches('^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$')
        && data.complete is bool && data.complete == (data.status == 1)
        && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 245760;
    }
    match /matchStatistics/{id} {
      allow read: if statisticsReader();
      // La telemetría admite remitentes sin sesión. No concede acceso a perfiles.
      allow create: if validStatistics(id, request.resource.data);
      // Solo reintentos idénticos; el borrado global requiere un lector autorizado.
      allow update: if validStatistics(id, request.resource.data) && request.resource.data == resource.data;
      allow delete: if statisticsReader();
    }

    // dashboardTelemetry/{runId}-{ownerUid}: observación privada de clientes lectores.
    // Header schemaVersion=1; runId/day/ownerUid inmutables; revision acumulada;
    // status 0..5; updatedAt impuesto por el servidor; payload JSON <=64 KiB.
    // Contiene solo nombres de juego y estadísticas, sin perfiles, emails o tokens.
    // No es una fuente autoritativa de premios. El lector valida el payload completo.
    function validDashboard(id, data) {
      return data.keys().hasOnly(['schemaVersion', 'runId', 'ownerUid', 'day', 'revision', 'status', 'updatedAt', 'payload'])
        && data.keys().hasAll(['schemaVersion', 'runId', 'ownerUid', 'day', 'revision', 'status', 'updatedAt', 'payload'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.runId is string && data.runId.matches('^[0-9a-f]{32}$')
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && googleOwner(data.ownerUid)
        && id == data.runId + '-' + data.ownerUid
        && data.day is string && data.day.matches('^(20[2-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.revision is int && data.revision > 0 && data.revision <= 1892160000
        && data.status is int && data.status >= 0 && data.status <= 5
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.payload is string && data.payload.size() > 0 && data.payload.size() <= 65536;
    }
    match /dashboardTelemetry/{id} {
      allow read: if statisticsReader();
      allow create: if statisticsReader() && validDashboard(id, request.resource.data);
      allow update: if statisticsReader() && validDashboard(id, request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.runId == resource.data.runId
        && request.resource.data.day == resource.data.day
        && request.resource.data.revision >= resource.data.revision
        && (resource.data.status != 1 || request.resource.data.status == 1);
      allow delete: if statisticsReader() && googleOwner(resource.data.ownerUid);
    }

    // Aviso publico del antiguo servicio, conservado para compatibilidad.
    match /publicAccountServer/current {
      allow get: if resource.data.keys().hasOnly(['url', 'expiresAt', 'protocol'])
        && resource.data.url is string && resource.data.url.size() <= 256
        && resource.data.url.matches('wss://[a-z0-9-]+[.]trycloudflare[.]com/play')
        && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time
        && resource.data.expiresAt <= request.time + duration.value(3, 'm')
        && resource.data.protocol is int;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if googleOwner(uid);
      // Los usuarios nuevos solo pueden crear su cabecera vacia.
      allow create: if googleOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'gold', 'wins', 'losses', 'itemCount', 'schemaVersion'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'gold', 'wins', 'losses', 'itemCount', 'schemaVersion'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.gold is int && request.resource.data.gold == 0
        && request.resource.data.wins is int && request.resource.data.wins == 0
        && request.resource.data.losses is int && request.resource.data.losses == 0
        && request.resource.data.itemCount is int && request.resource.data.itemCount == 0
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1;
      allow list, update, delete: if false;

      match /items/{itemId} {
        allow get, list: if googleOwner(uid);
        allow write: if false;
      }

      match /loadouts/{loadoutId} {
        allow get, list: if googleOwner(uid);

        function slotValid(itemId, expectedSlot) {
          return itemId is string
            && (itemId == '' || (itemId.matches('^[0-9a-f]{32}$')
              && get(/databases/$(database)/documents/users/$(uid)/items/$(itemId)).data.slot == expectedSlot));
        }

        function validLoadout(data) {
          return data.keys().hasOnly(['boots', 'hat', 'chest', 'weapon', 'goldRing', 'magicRing'])
            && data.keys().hasAll(['boots', 'hat', 'chest', 'weapon'])
            && slotValid(data.boots, 'boots')
            && slotValid(data.hat, 'hat')
            && slotValid(data.chest, 'chest')
            && slotValid(data.weapon, 'weapon')
            && slotValid(data.get('goldRing', ''), 'goldRing')
            && slotValid(data.get('magicRing', ''), 'magicRing');
        }
        // Selección atómica de hasta seis piezas propias; no modifica oro ni objetos.
        allow create, update: if googleOwner(uid) && loadoutId == 'active'
          && validLoadout(request.resource.data);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // El SDK Admin del servidor usa IAM, no estas reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
