rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // matchStatistics/{runId}: contrato anónimo validado por el servidor Admin.
    // statisticsReaders/{uid}: { enabled: bool }; solo Admin concede o revoca roles.
    function statisticsReader() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/statisticsReaders/$(request.auth.uid))
        && get(/databases/$(database)/documents/statisticsReaders/$(request.auth.uid)).data.enabled == true;
    }
    match /statisticsReaders/{uid} {
      allow get: if googleOwner(uid);
      allow list, write: if false;
    }
    match /matchStatistics/{runId} {
      allow read: if statisticsReader();
      allow write: if false;
    }

    // Aviso publico del antiguo servicio, conservado para compatibilidad.
    match /publicAccountServer/current {
      allow get: if resource.data.keys().hasOnly(['url', 'expiresAt', 'protocol'])
        && resource.data.url is string && resource.data.url.size() <= 256
        && resource.data.url.matches('wss://[a-z0-9-]+[.]trycloudflare[.]com/play')
        && resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time
        && resource.data.expiresAt <= request.time + duration.value(3, 'm')
        && resource.data.protocol is int;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if googleOwner(uid);
      // Los usuarios nuevos solo pueden crear su cabecera vacia.
      allow create: if googleOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'gold', 'wins', 'losses', 'itemCount', 'schemaVersion'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'gold', 'wins', 'losses', 'itemCount', 'schemaVersion'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.gold == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.itemCount == 0
        && request.resource.data.schemaVersion == 1;
      allow list, update, delete: if false;

      match /items/{itemId} {
        allow get, list: if googleOwner(uid);
        allow write: if false;
      }

      match /loadouts/{loadoutId} {
        allow get, list: if googleOwner(uid);

        function slotValid(itemId, expectedSlot) {
          return itemId is string
            && (itemId == '' || (itemId.matches('^[0-9a-f]{32}$')
              && exists(/databases/$(database)/documents/users/$(uid)/items/$(itemId))
              && get(/databases/$(database)/documents/users/$(uid)/items/$(itemId)).data.slot == expectedSlot));
        }

        // Una unica selección de hasta cuatro piezas propias. Oro y objetos no cambian.
        allow create, update: if googleOwner(uid)
          && loadoutId == 'active'
          && request.resource.data.keys().hasOnly(['boots', 'hat', 'chest', 'weapon'])
          && request.resource.data.keys().hasAll(['boots', 'hat', 'chest', 'weapon'])
          && slotValid(request.resource.data.boots, 'boots')
          && slotValid(request.resource.data.hat, 'hat')
          && slotValid(request.resource.data.chest, 'chest')
          && slotValid(request.resource.data.weapon, 'weapon');
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // El SDK Admin del servidor usa IAM, no estas reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
