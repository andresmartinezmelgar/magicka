# Servidor central: copia estos valores al entorno del proceso del servidor.
# Si las cuatro opciones están vacías, las cuentas permanecen desactivadas.
# Opcional: archivo de configuración web del servidor; las variables no vacías prevalecen.
ARCANA_FIREBASE_CONFIG=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
ARCANA_PUBLIC_URL=
# Ruta a una credencial privada fuera del repositorio; también admite credenciales de aplicación de Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=
# Mantén este directorio en un volumen persistente entre despliegues.
ARCANA_REWARD_OUTBOX=

# Historial y cola anónima de partidas; Docker usa /app/data/match-statistics.
# Déjalo vacío para usar la carpeta predeterminada junto a logs.
ARCANA_MATCH_STATISTICS_DIR=
