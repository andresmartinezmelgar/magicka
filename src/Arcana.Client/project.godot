; Arcana Arena v0.6.1 - abrir con Godot 4.5.2 .NET.
config_version=5

[application]
config/name="Arcana Arena"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Arcana.Client"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.038, 0.064, 1)
