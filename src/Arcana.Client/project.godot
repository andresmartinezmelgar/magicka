; Arcana Arena v0.12.2 - abrir con Godot 4.5.2 .NET.
config_version=5

[application]
config/name="Arcana Arena"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/viewport_width.mobile=1440
window/size/viewport_height.mobile=720
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect.mobile="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[dotnet]
project/assembly_name="Arcana.Client"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.038, 0.064, 1)
